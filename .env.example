# Required
POSTGRES_URL=postgresql://offboard:offboard@localhost:5432/offboard
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# Optional — features degrade gracefully without these
# API_HOST=127.0.0.1
# API_PORT=3001
# WEB_ORIGIN=http://localhost:5173
# API_URL=http://localhost:3001

# AI (résumé analysis, job matching, AI Apply)
# ANTHROPIC_API_KEY=sk-ant-...
# AI_GATEWAY_API_KEY=

# Email
# RESEND_API_KEY=re_...
# AUTH_EMAIL_FROM=noreply@your-domain.com

# Billing (co-pay)
# ABACATEPAY_API_KEY=
# ABACATEPAY_WEBHOOK_SECRET=

# Integrations
# SLACK_SIGNING_SECRET=
# CRON_SECRET=
# WEBHOOK_SECRET=

# Tracking (Correios)
# TRACKING_API_KEY=
# TRACKING_BASE_URL=https://api.wonca.com.br

# AI Apply (browser automation)
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Captcha (contact form)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Misc
# PUBLIC_PAGE_ORIGIN=http://localhost:5173
# RESUME_STORAGE_DIR=./tmp/resumes
# BACKOFFICE_STAFF_EMAILS=admin@example.com
