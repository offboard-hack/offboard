{
  "expo": {
    "name": "Offboard",
    "slug": "offboard",
    "scheme": "offboard",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.offboard.employee"
    },
    "android": {
      "package": "com.offboard.employee"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icon.png",
      "lang": "pt-BR"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-sharing"]
  }
}
