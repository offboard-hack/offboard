{
  "name": "@offboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./worker": "./src/worker.ts",
    "./contract": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "scenario": "tsx src/scenario/cli.ts",
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit && oxlint src",
    "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --target=node22 --format=esm --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);' --outfile=dist/vercel.mjs"
  },
  "dependencies": {
    "@abacatepay/sdk": "^3.1.1",
    "@abacatepay/types": "^4.1.1",
    "@ai-sdk/anthropic": "^4.0.109",
    "@elysia/cors": "1.4.3",
    "@elysia/node": "1.4.6",
    "@offboard/access": "0.1.0",
    "@offboard/db": "0.1.0",
    "@offboard/employee": "0.1.0",
    "ai": "^7.0.181",
    "better-auth": "^1.7.27",
    "elysia": "1.4.32",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "resend": "^6.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261119.0-beta",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
