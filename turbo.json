{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "API_URL",
        "AUTH_EMAIL_FROM",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CRON_SECRET",
        "POSTGRES_URL",
        "PUBLIC_PAGE_ORIGIN",
        "RESEND_API_KEY",
        "RESEND_BASE_URL",
        "ABACATEPAY_API_KEY",
        "ABACATEPAY_WEBHOOK_SECRET",
        "SLACK_API_URL",
        "SLACK_BOT_TOKEN",
        "SLACK_SIGNING_SECRET",
        "WEBHOOK_SECRET",
        "WEB_ORIGIN"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tools/oxlint/anti-slop/**",
        "$TURBO_ROOT$/tools/oxlint/offboard/**"
      ]
    }
  }
}
