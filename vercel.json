{
  "buildCommand": "npm run build:vercel -w @offboard/api && npm run build -w @offboard/web",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "apps/web/dist/client",
  "functions": {
    "api/ssr.mjs": {
      "includeFiles": "apps/web/dist/**"
    },
    "api/offboard.mjs": {
      "memory": 256,
      "maxDuration": 10,
      "includeFiles": "apps/api/dist/**"
    }
  },
  "crons": [{ "path": "/api/correios/check", "schedule": "0 8 * * *" }],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/offboard" },
    { "source": "/api/auth/:path*", "destination": "/api/offboard" },
    { "source": "/api/session", "destination": "/api/offboard" },
    { "source": "/api/offboardings", "destination": "/api/offboard" },
    { "source": "/api/offboardings/:path*", "destination": "/api/offboard" },
    { "source": "/api/tasks/:path*", "destination": "/api/offboard" },
    { "source": "/api/subtasks/:path*", "destination": "/api/offboard" },
    { "source": "/api/integrations", "destination": "/api/offboard" },
    { "source": "/api/integrations/:path*", "destination": "/api/offboard" },
    { "source": "/api/job-feeds", "destination": "/api/offboard" },
    { "source": "/api/job-feeds/:path*", "destination": "/api/offboard" },
    { "source": "/api/recruiter-partners", "destination": "/api/offboard" },
    { "source": "/api/recruiter-partners/:path*", "destination": "/api/offboard" },
    { "source": "/api/recruiters/:path*", "destination": "/api/offboard" },
    { "source": "/api/action-configs", "destination": "/api/offboard" },
    { "source": "/api/action-configs/:path*", "destination": "/api/offboard" },
    { "source": "/api/me", "destination": "/api/offboard" },
    { "source": "/api/me/:path*", "destination": "/api/offboard" },
    { "source": "/api/jobs/:path*", "destination": "/api/offboard" },
    { "source": "/api/team", "destination": "/api/offboard" },
    { "source": "/api/team/:path*", "destination": "/api/offboard" },
    { "source": "/api/talent/:path*", "destination": "/api/offboard" },
    { "source": "/api/webhooks/:path*", "destination": "/api/offboard" },
    { "source": "/api/correios/:path*", "destination": "/api/offboard" },
    { "source": "/api/background/:path*", "destination": "/api/offboard" },
    { "source": "/api/public/:path*", "destination": "/api/offboard" },
    { "source": "/((?!assets/).*)", "destination": "/api/ssr" }
  ]
}
